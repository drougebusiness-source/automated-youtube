# Copy this file to .env and fill in what you use. Never commit .env.

# Claude writes titles, descriptions and tags. Optional: without it, built-in templates are used.
ANTHROPIC_API_KEY=

# AI music (music.source: elevenlabs). Get a key at elevenlabs.io (paid plan needed for commercial use).
ELEVENLABS_API_KEY=

# AI background images (visuals.background_source: openai). Optional.
OPENAI_API_KEY=

# YouTube upload. Created by `python -m ytauto auth` (see README). For GitHub Actions,
# paste the contents of token.json into a secret named YOUTUBE_TOKEN_JSON.
YOUTUBE_TOKEN_JSON=
